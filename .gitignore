# Dependencies
node_modules/

# Secrets — never commit
.env
.env.*
!.env.example

# Build output
dist/
build/
# TypeScript's incremental-build cache. Tracked by mistake, which put a binary
# diff in every commit that happened to follow a build.
*.tsbuildinfo

# Uploaded files (local storage driver). Licence documents and lab reports are
# health data and business records — they belong in object storage, not in git.
uploads/
.test-uploads/

# Expo
.expo/
web-build/

# Native projects generated by `expo prebuild` / `expo run:android|ios`.
# These are build output — the source of truth is app.json plus the config
# plugins. Regenerate with `npx expo prebuild --clean` rather than editing them,
# and re-run prebuild after changing any native config (splash, icons, plugins)
# or the change will not reach an existing dev build.
mobile/apps/*/android/
mobile/apps/*/ios/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Prisma
prisma/*.db
prisma/*.db-journal

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test / coverage
coverage/
.jest-cache/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
