# Environment Configuration - Health Buddy Backend
# Copy to .env and fill in real values. NEVER commit .env.

PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/healthbuddy?schema=public"

# Redis (OTP storage, rate limiting, slot locks)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_TLS="false"

# JWT secrets — REQUIRED, min 32 chars, no defaults.
# Generate each with:  openssl rand -hex 32
# Never reuse these between environments and never commit real values.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# SMS gateway. "mock" logs the OTP instead of sending; rejected in production.
SMS_PROVIDER="mock"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Dev-only: return the OTP in the send-otp HTTP response.
# Boot fails if this is "true" while NODE_ENV=production.
EXPOSE_DEV_OTP="false"

# Comma-separated CORS allowlist, e.g. "https://app.healthbuddy.com".
# Empty reflects any origin — allowed in dev only, required in production.
CORS_ORIGINS=""

# ---------------------------------------------------------------------------
# File storage
#
# "local" writes under UPLOAD_DIR and is rejected in production: a container
# filesystem is wiped on redeploy, taking every licence and lab report with it.
# "r2" is Cloudflare R2, "s3" is AWS or any S3-compatible host — same driver.
#
# Keep the bucket PRIVATE. Do not enable an r2.dev public URL: reads are
# authorised per request and streamed, so a public bucket only creates a way
# to reach a patient's lab report with no login.
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=10
FILE_LINK_TTL_SECONDS=300

# For STORAGE_DRIVER=r2: create an R2 API token (Object Read & Write) and use
# its Access Key ID / Secret Access Key here. R2_ACCOUNT_ID is the Cloudflare
# account id, which forms https://<id>.r2.cloudflarestorage.com.
R2_ACCOUNT_ID=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Only for STORAGE_DRIVER=s3. R2 derives both from R2_ACCOUNT_ID.
S3_REGION=""
S3_ENDPOINT=""

# ---------------------------------------------------------------------------
# Payments
#
# The platform must NOT collect into its own account and pay partners out
# later — that is a payment-aggregator activity requiring RBI authorisation.
# Route (Razorpay) splits at settlement so the licensed party holds the money.
#
# "mock" simulates the whole flow offline for testing and is rejected in
# production, where it would mark orders paid without collecting anything.
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER="mock"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Set this in the Razorpay dashboard under Webhooks. Without it, anyone could
# post a forged "payment succeeded" and release an unpaid order to a partner.
RAZORPAY_WEBHOOK_SECRET=""

# Platform commission, percent. Per-partner overrides live on their profile.
COMMISSION_PHARMACY_PCT=10
COMMISSION_LAB_PCT=15
COMMISSION_DOCTOR_PCT=10

# Cash on delivery. The cap limits the loss when an order is refused at the door.
COD_ENABLED="true"
COD_MAX_ORDER_VALUE=5000

# ---------------------------------------------------------------------------
# Video consultations
#
# "mock" renders the call shell with no transport. "jitsi" and "daily" both
# return a URL a plain browser opens, so they work in Expo Go — a native WebRTC
# SDK would need a development build.
#
# Free tiers: Daily ~10,000 participant-minutes/month; Jitsi is free, but
# meet.jit.si requires the FIRST participant to sign in with Google/GitHub/
# Facebook. Point JITSI_DOMAIN at your own deployment to remove that.
#
# Neither public host is an appropriate place for clinical calls at scale —
# for launch, self-host Jitsi or take a paid plan with a data-processing
# agreement that satisfies the DPDP Act.
# ---------------------------------------------------------------------------
VIDEO_PROVIDER="mock"
JITSI_DOMAIN="meet.jit.si"
DAILY_API_KEY=""
DAILY_SUBDOMAIN=""
VIDEO_JOIN_LEAD_MINUTES=10
VIDEO_JOIN_GRACE_MINUTES=60
