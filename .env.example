# Environment Configuration - Health Buddy Backend
# Copy to .env and fill in real values. NEVER commit .env.

PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/healthbuddy?schema=public"

# Redis (OTP storage, rate limiting, slot locks)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_TLS="false"

# JWT secrets — REQUIRED, min 32 chars, no defaults.
# Generate each with:  openssl rand -hex 32
# Never reuse these between environments and never commit real values.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# SMS gateway. "mock" logs the OTP instead of sending; rejected in production.
SMS_PROVIDER="mock"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Dev-only: return the OTP in the send-otp HTTP response.
# Boot fails if this is "true" while NODE_ENV=production.
EXPOSE_DEV_OTP="false"

# Comma-separated CORS allowlist, e.g. "https://app.healthbuddy.com".
# Empty reflects any origin — allowed in dev only, required in production.
CORS_ORIGINS=""
