{
  "expo": {
    "name": "Health Buddy",
    "slug": "healthbuddy-patient",
    "scheme": "healthbuddy-patient",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.healthbuddy.patient",
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSCameraUsageDescription": "Health Buddy uses the camera for your video consultation, and to photograph a prescription or report you attach.",
        "NSMicrophoneUsageDescription": "Health Buddy uses the microphone so your doctor can hear you during a video consultation.",
        "NSPhotoLibraryUsageDescription": "Health Buddy asks for your photos so you can attach a prescription or a lab report you have already saved.",
        "NSLocationWhenInUseUsageDescription": "Health Buddy uses your location to show pharmacies, labs and doctors that serve your area, and to tell the ambulance control room where you are when you raise an emergency."
      }
    },
    "android": {
      "package": "com.healthbuddy.patient",
      "adaptiveIcon": {
        "backgroundColor": "#e7fff2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#e7fff2",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Health Buddy uses your location to show pharmacies, labs and doctors that serve your area, and to tell the ambulance control room where you are when you raise an emergency."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Health Buddy asks for your photos so you can attach a prescription or a lab report you have already saved.",
          "cameraPermission": "Health Buddy uses the camera for your video consultation, and to photograph a prescription or report you attach."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d5d438ae-0004-435e-ae12-92dbdb215a76"
      }
    },
    "owner": "viqstar"
  }
}
