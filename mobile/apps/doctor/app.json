{
  "expo": {
    "name": "Health Buddy Doctor",
    "slug": "healthbuddy-doctor",
    "scheme": "healthbuddy-doctor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.healthbuddy.doctor",
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSCameraUsageDescription": "Health Buddy Doctor uses the camera for video consultations, and to photograph your registration certificate and qualifications.",
        "NSMicrophoneUsageDescription": "Health Buddy Doctor uses the microphone so your patient can hear you during a video consultation.",
        "NSPhotoLibraryUsageDescription": "Health Buddy Doctor asks for your photos so you can attach your registration certificate or qualification from your library.",
        "NSLocationWhenInUseUsageDescription": "Health Buddy Doctor uses your location only to prefill your clinic address when you set up your profile."
      }
    },
    "android": {
      "package": "com.healthbuddy.doctor",
      "adaptiveIcon": {
        "backgroundColor": "#e7fff2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#e7fff2",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Health Buddy Doctor uses your location only to prefill your clinic address when you set up your profile."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Health Buddy Doctor asks for your photos so you can attach your registration certificate or qualification from your library.",
          "cameraPermission": "Health Buddy Doctor uses the camera for video consultations, and to photograph your registration certificate and qualifications."
        }
      ]
    ]
  }
}
