{
  /**
   * The shared compiler settings for every mobile package.
   *
   * This file used to declare these rules while nothing extended it — each app
   * pointed straight at `expo/tsconfig.base`, so `noUnusedLocals` and the rest
   * were never actually enforced and the file read as a standard it was not.
   * It now sits between Expo's base and the packages, which all extend it.
   */
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true
  }
}
