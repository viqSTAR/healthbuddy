// Prisma Schema for Health Buddy Platform
//
// Four client surfaces sit on this schema: the patient app, the doctor app,
// the partner app (pharmacy + lab), and the admin web panel.
//
// Two rules drive the design and should survive future edits:
//
//  1. A provider's ROLE is a grant, never a claim. Applicants submit a
//     ProviderApplication describing what they want to be; an admin approves
//     it and only then does the server create the Doctor/Pharmacy/LabPartner
//     row and change User.role. Nothing in the request body decides a role.
//
//  2. Uploaded files are addressed by opaque storage key, never a public URL.
//     Lab reports and prescriptions are health data; access is authorised per
//     request and served through short-lived signed links.
datasource db {
  provider = "postgresql"
  /// Pooled endpoint (PgBouncer). Serverless Postgres suspends idle compute and
  /// drops direct connections, which surfaces as a stream of "connection
  /// forcibly closed" errors; the pooler absorbs that.
  url      = env("DATABASE_URL")
  /// Unpooled. Schema changes are DDL, which PgBouncer's transaction mode
  /// cannot run, so the CLI needs a direct connection. Falls back to
  /// DATABASE_URL when unset, which is correct for a non-pooled host.
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PATIENT
  DOCTOR
  LAB_PARTNER
  PHARMACY
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AppointmentType {
  VIDEO
  IN_PERSON
}

enum SlotStatus {
  AVAILABLE
  LOCKED
  BOOKED
}

/// Why stock moved.
///
/// Stock is not a number a shop edits — it is the running total of movements,
/// each with a reason. A bare number cannot answer "we are 40 boxes short, what
/// happened?", and that question is the whole job of an inventory system.
enum StockMovementReason {
  /// Received from a distributor.
  PURCHASE
  /// Physical recount. The delta is whatever reconciles the books.
  CORRECTION
  /// Dispatched against a platform order.
  SALE_ONLINE
  /// Sold over the counter, off-platform.
  SALE_OFFLINE
  /// Came back from a customer.
  RETURN
  /// Past its expiry date.
  EXPIRED
  /// Broken, contaminated, or a failed cold chain.
  DAMAGED
  /// A reservation released because the order was cancelled.
  ORDER_CANCELLED
}

/// PENDING_PAYMENT exists so a partner never starts work on an order nobody has
/// paid for. Prepaid orders sit here until the gateway confirms; cash-on-delivery
/// orders skip it and are PLACED immediately.
enum OrderStatus {
  PENDING_PAYMENT
  PLACED
  ACCEPTED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum LabOrderStatus {
  PENDING_PAYMENT
  BOOKED
  ACCEPTED
  SAMPLE_COLLECTED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum EmergencyStatus {
  RAISED
  DISPATCHED
  EN_ROUTE
  ARRIVED
  RESOLVED
  CANCELLED
}

/// Which application an entity belongs to. One person may hold a patient and a
/// provider identity, so device tokens are keyed by user *and* app.
enum AppId {
  PATIENT
  DOCTOR
  PARTNER
  ADMIN
}

// ---------------------------------------------------------------------------
// Provider onboarding & verification
// ---------------------------------------------------------------------------

enum ApplicationType {
  DOCTOR
  PHARMACY
  LAB
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum DocumentKind {
  // Doctor
  DOCTOR_REGISTRATION_CERT
  DOCTOR_QUALIFICATION
  // Pharmacy
  DRUG_LICENCE
  PHARMACIST_CERT
  // Lab
  LAB_REGISTRATION
  NABL_CERTIFICATE
  // Shared business proof
  GST_CERTIFICATE
  SHOP_ESTABLISHMENT
  ID_PROOF
  PREMISES_PHOTO
  // Clinical artefacts
  LAB_REPORT
  PRESCRIPTION_IMAGE
  /// Photo of a visible complaint (rash, wound, swelling), attached to an
  /// appointment so a doctor can assess without a video call.
  CONDITION_PHOTO
  PROFILE_PHOTO
}

// ---------------------------------------------------------------------------
// Drug classification — drives what a doctor may prescribe over telemedicine
// ---------------------------------------------------------------------------

/// Drugs & Cosmetics Act scheduling. SCHEDULE_X and NARCOTIC may never be sold
/// online and must be excluded from the patient-facing catalogue.
enum DrugSchedule {
  OTC
  SCHEDULE_H
  SCHEDULE_H1
  SCHEDULE_X
  NARCOTIC
}

/// Telemedicine Practice Guidelines drug lists.
///   LIST_O — over the counter, prescribable in any consult
///   LIST_A — first consult allowed, but video only
///   LIST_B — follow-up consultations only
///   PROHIBITED — never prescribable over telemedicine
enum TeleDrugList {
  LIST_O
  LIST_A
  LIST_B
  PROHIBITED
}

enum NotificationType {
  APPLICATION_SUBMITTED
  APPLICATION_APPROVED
  APPLICATION_REJECTED
  APPOINTMENT_BOOKED
  APPOINTMENT_CANCELLED
  CONSULT_READY
  PRESCRIPTION_ISSUED
  ORDER_PLACED
  ORDER_STATUS_CHANGED
  LAB_BOOKED
  LAB_REPORT_READY
  LOW_STOCK
  SOS_RAISED
  GENERIC
}

enum PaymentStatus {
  /// Created, awaiting the payer. Also where a COD payment sits until delivery.
  PENDING
  PAID
  FAILED
  REFUNDED
  /// Part of the amount was returned — a cancelled line in a multi-item order.
  PARTIALLY_REFUNDED
}

enum PaymentPurpose {
  APPOINTMENT
  MEDICINE_ORDER
  LAB_ORDER
  /// One approved prescription basket — medicines and tests together, paid for
  /// once. Splitting it into a payment per order would make the patient face
  /// three checkout sheets for one decision.
  PRESCRIPTION_BASKET
}

/// How the patient chose to pay. COD is settled by the delivery agent and is the
/// only method where goods move before money does.
enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  WALLET
  COD
}

/// Who a settlement leg pays out to.
enum PayeeType {
  PHARMACY
  LAB
  DOCTOR
  PLATFORM
}

enum SplitStatus {
  PENDING
  SETTLED
  REVERSED
}

/// Lifecycle of turning a prescription into actual orders.
///
/// PENDING_CONSENT is the whole point: a prescription is clinical advice, and
/// buying what it names is a separate decision the patient has to make. Nothing
/// is ordered or charged until they approve a priced basket.
enum FulfilmentStatus {
  PENDING_CONSENT
  CONSENTED
  DECLINED
  EXPIRED
}

/// Who a health tip is aimed at. Tips are matched against the patient's own
/// record, never broadcast indiscriminately.
enum HealthTipAudience {
  EVERYONE
  CONDITION
  ALLERGY
  DIAGNOSIS
  AGE_RANGE
}

enum EmergencyServiceType {
  AMBULANCE
  HOSPITAL
  BLOOD_BANK
  POISON_CONTROL
  MENTAL_HEALTH
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id          String   @id @default(uuid())
  phoneNumber String   @unique
  role        Role     @default(PATIENT)
  isVerified  Boolean  @default(true)
  isSuspended Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patient    Patient?
  doctor     Doctor?
  labPartner LabPartner?
  pharmacy   Pharmacy?

  applications         ProviderApplication[] @relation("ApplicationApplicant")
  reviewedApplications ProviderApplication[] @relation("ApplicationReviewer")
  documents            Document[]
  deviceTokens         DeviceToken[]
  notifications        Notification[]
  payments             Payment[]
  auditLogs            AuditLog[]
  assignedOrders       MedicineOrder[]       @relation("OrderAgent")
  assignedLabOrders    LabOrder[]            @relation("LabOrderAgent")

  @@index([phoneNumber])
  @@index([role])
}

model Patient {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName          String
  email             String?
  age               Int?
  gender            Gender?
  bloodGroup        String?
  emergencyContact  String?
  address           String?
  latitude          Float?
  longitude         Float?
  allergies         String?
  chronicConditions String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  appointments   Appointment[]
  prescriptions  Prescription[]
  medicineOrders MedicineOrder[]
  labOrders      LabOrder[]
  emergencyLogs  EmergencySOS[]
  fulfilments    PrescriptionFulfilment[]
  tipDeliveries  HealthTipDelivery[]
}

model Doctor {
  id              String  @id @default(uuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  specialty       String
  qualification   String?
  experienceYears Int     @default(0)
  consultationFee Float
  rating          Float   @default(4.9)
  about           String?
  languages       String?
  clinicAddress   String?
  isAvailable     Boolean @default(true)

  /// Registration number issued by the NMC / State Medical Council. The
  /// Telemedicine Practice Guidelines require this on every prescription.
  councilRegistrationNumber String?
  councilName               String?
  /// ABDM Healthcare Professionals Registry id, when the doctor has one.
  hprId                     String?
  verifiedAt                DateTime?

  /// Linked account at the payment aggregator. Until this is set the doctor's
  /// share cannot be split out and is held for manual settlement.
  payoutAccountId   String?
  /// Overrides the platform default when set. Percent.
  commissionPercent Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slots         DoctorSlot[]
  appointments  Appointment[]
  prescriptions Prescription[]

  @@index([specialty])
  @@index([isAvailable])
}

model Pharmacy {
  id      String @id @default(uuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name    String
  address String

  city             String?
  state            String?
  pincode          String?
  latitude         Float?
  longitude        Float?
  deliveryRadiusKm Float   @default(10)
  isActive         Boolean @default(true)

  /// Retail drug licence issued by the State Drug Control Authority. The
  /// platform is a marketplace — the partner holds the licence, not us.
  /// An expired licence must suspend the partner.
  drugLicenceNumber String?
  drugLicenceExpiry DateTime?
  gstin             String?
  pharmacistName    String?
  /// ABDM Health Facility Registry id.
  hfrId             String?
  verifiedAt        DateTime?

  /// Linked account at the payment aggregator, and this partner's commission
  /// rate when it differs from the platform default.
  payoutAccountId   String?
  commissionPercent Float?

  createdAt DateTime @default(now())
  // Defaulted so the column can backfill over pharmacies created before this
  // field existed; @updatedAt still maintains it on every write.
  updatedAt DateTime @default(now()) @updatedAt

  orders    MedicineOrder[]
  inventory PharmacyInventory[]

  @@index([isActive])
}

model LabPartner {
  id       String @id @default(uuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  location String

  address        String?
  city           String?
  state          String?
  pincode        String?
  latitude       Float?
  longitude      Float?
  homeCollection Boolean @default(true)
  isActive       Boolean @default(true)

  labRegistrationNumber String?
  nablAccredited        Boolean   @default(false)
  nablCertNumber        String?
  nablExpiry            DateTime?
  hfrId                 String?
  verifiedAt            DateTime?

  payoutAccountId   String?
  commissionPercent Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  labOrders LabOrder[]
  offerings LabOffering[]

  @@index([isActive])
}

/// A request to become a provider. Submitting one grants nothing — an admin
/// approves it, and approval is what creates the profile row and flips the
/// user's role. `type` selects the registration form and the post-approval UI;
/// it is never consulted for authorisation.
model ProviderApplication {
  id     String            @id @default(uuid())
  userId String
  user   User              @relation("ApplicationApplicant", fields: [userId], references: [id], onDelete: Cascade)
  type   ApplicationType
  status ApplicationStatus @default(DRAFT)

  // Common business identity
  displayName  String
  contactEmail String?
  address      String
  city         String?
  state        String?
  pincode      String?
  latitude     Float?
  longitude    Float?

  // ABDM registry identifiers. HPR for individual professionals, HFR for
  // facilities (which explicitly covers pharmacies and diagnostic labs).
  hprId             String?
  hfrId             String?
  registryVerified  Boolean   @default(false)
  registryCheckedAt DateTime?
  registryResponse  Json?

  // Doctor-specific
  councilRegistrationNumber String?
  councilName               String?
  qualification             String?
  specialty                 String?
  experienceYears           Int?
  consultationFee           Float?

  // Pharmacy-specific
  drugLicenceNumber   String?
  drugLicenceExpiry   DateTime?
  gstin               String?
  pharmacistName      String?
  pharmacistRegNumber String?

  // Lab-specific
  labRegistrationNumber String?
  nablAccredited        Boolean   @default(false)
  nablCertNumber        String?
  nablExpiry            DateTime?
  homeCollection        Boolean   @default(true)

  documents Document[]

  submittedAt      DateTime?
  reviewedByUserId String?
  reviewedBy       User?     @relation("ApplicationReviewer", fields: [reviewedByUserId], references: [id])
  reviewedAt       DateTime?
  /// Shown to the applicant so a rejection is actionable rather than a dead end.
  rejectionReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One live application per type per user; resubmission edits it in place.
  @@unique([userId, type])
  @@index([status, type])
  @@index([submittedAt])
}

/// An uploaded file. `storageKey` is an opaque key into the storage driver, not
/// a URL — nothing here is publicly reachable. Downloads go through an
/// authorisation check and a short-lived signed link.
model Document {
  id          String       @id @default(uuid())
  ownerUserId String
  owner       User         @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  kind        DocumentKind
  storageKey  String       @unique
  fileName    String
  mimeType    String
  sizeBytes   Int

  applicationId String?
  application   ProviderApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  labOrderId String?
  labOrder   LabOrder? @relation(fields: [labOrderId], references: [id], onDelete: Cascade)

  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([ownerUserId])
  @@index([applicationId])
  @@index([labOrderId])
  @@index([appointmentId])
}

// ---------------------------------------------------------------------------
// Consultations
// ---------------------------------------------------------------------------

model DoctorSlot {
  id        String     @id @default(uuid())
  doctorId  String
  doctor    Doctor     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD
  startTime String // HH:mm
  endTime   String // HH:mm
  status    SlotStatus @default(AVAILABLE)
  createdAt DateTime   @default(now())

  appointment Appointment?

  @@unique([doctorId, date, startTime])
  @@index([doctorId, date])
}

model Appointment {
  id            String            @id @default(uuid())
  patientId     String
  patient       Patient           @relation(fields: [patientId], references: [id])
  doctorId      String
  doctor        Doctor            @relation(fields: [doctorId], references: [id])
  slotId        String            @unique
  slot          DoctorSlot        @relation(fields: [slotId], references: [id])
  type          AppointmentType   @default(VIDEO)
  status        AppointmentStatus @default(SCHEDULED)
  symptoms      String?
  /// Unguessable room identifier, minted on first join. A room name is a bearer
  /// credential on most hosted video services — anyone who can guess it walks
  /// into the consultation — so it is random, never derived from the id.
  meetingRoomId String?
  /// Which provider minted `meetingRoomId`, so a room is never reinterpreted
  /// against a different service after a config change.
  meetingProvider String?

  /// Set at booking time by counting the patient's earlier completed consults
  /// with this doctor. Determines which telemedicine drug lists are available.
  isFollowUp Boolean   @default(false)
  startedAt  DateTime?
  endedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prescription Prescription?
  payment      Payment?
  /// Condition photos the patient attached when booking.
  documents    Document[]

  @@index([patientId])
  @@index([doctorId, status])
}

model Prescription {
  id            String      @id @default(uuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  patientId     String
  patient       Patient     @relation(fields: [patientId], references: [id])
  doctorId      String
  doctor        Doctor      @relation(fields: [doctorId], references: [id])
  diagnosis     String
  /// PrescribedMedicine rows carry the structured items; this keeps the
  /// free-text rendering the doctor confirmed at issue time.
  medicines     Json
  notes         String?
  advice        String?
  followUpDate  String?

  /// Stamped at issue time rather than joined later, so the prescription
  /// remains a faithful record even if the doctor's profile changes.
  doctorRegistrationNumber String?
  consultationMode         AppointmentType @default(VIDEO)
  wasFollowUp              Boolean         @default(false)

  createdAt DateTime @default(now())

  items      PrescribedMedicine[]
  labTests   PrescribedLabTest[]
  fulfilment PrescriptionFulfilment?

  @@index([patientId])
  @@index([doctorId])
}

/// A lab test ordered as part of a prescription, so "doctor advised a blood
/// test" becomes something the patient can act on in one tap rather than
/// hunting through the catalogue themselves.
model PrescribedLabTest {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  labPackageId   String?
  labPackage     LabPackage?  @relation(fields: [labPackageId], references: [id])
  /// Free text fallback for a test not in the catalogue.
  testName       String
  instructions   String?
  urgent         Boolean      @default(false)

  @@index([prescriptionId])
  @@index([labPackageId])
}

/// The consent gate between a prescription and real orders.
///
/// Created automatically when a doctor issues a prescription, but it creates
/// NOTHING on its own. It holds a priced basket — medicines quoted from the
/// cheapest in-stock pharmacy, tests from the cheapest active lab — and waits.
/// Only an explicit patient approval turns it into a MedicineOrder and
/// LabOrders. Ignored, it expires untouched.
model PrescriptionFulfilment {
  id             String           @id @default(uuid())
  prescriptionId String           @unique
  prescription   Prescription     @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  status         FulfilmentStatus @default(PENDING_CONSENT)

  /// Snapshot of the offer, priced at the moment it was made. Kept verbatim so
  /// the patient is never charged a price different from the one they approved.
  medicineQuote Json?
  labQuote      Json?
  medicineTotal Float @default(0)
  labTotal      Float @default(0)
  deliveryFee   Float @default(0)

  consentedAt   DateTime?
  declinedAt    DateTime?
  declineReason String?
  /// Prices go stale; an unanswered offer lapses rather than lingering.
  expiresAt     DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medicineOrders MedicineOrder[]
  labOrders      LabOrder[]
  /// One payment covers the whole approved basket.
  payment        Payment?

  @@index([patientId, status])
  @@index([status, expiresAt])
}

/// Structured prescription line, linked to the catalogue so a patient can order
/// against it and the pharmacy can verify the prescription actually covers what
/// is being dispensed.
model PrescribedMedicine {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicineId     String?
  medicine       Medicine?    @relation(fields: [medicineId], references: [id])
  /// Free text fallback for a drug not in the catalogue.
  name           String
  dosage         String
  frequency      String
  durationDays   Int?
  instructions   String?

  @@index([prescriptionId])
  @@index([medicineId])
}

// ---------------------------------------------------------------------------
// Pharmacy
// ---------------------------------------------------------------------------

/// Canonical drug catalogue. Price and stock live per pharmacy in
/// PharmacyInventory — this row only carries the reference MRP.
model Medicine {
  id           String  @id @default(uuid())
  name         String
  category     String
  /// Reference MRP. The price actually charged comes from PharmacyInventory.
  price        Float
  stock        Int     @default(100)
  description  String?
  composition  String?
  manufacturer String?

  schedule             DrugSchedule @default(OTC)
  teleList             TeleDrugList @default(LIST_O)
  requiresPrescription Boolean      @default(false)

  createdAt DateTime @default(now())

  inventory  PharmacyInventory[]
  prescribed PrescribedMedicine[]

  @@index([category])
  @@index([schedule])
}

/// Per-pharmacy price and stock. Without this two pharmacies cannot list the
/// same medicine at different prices, which breaks at the second partner.
model PharmacyInventory {
  id           String   @id @default(uuid())
  pharmacyId   String
  pharmacy     Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medicineId   String
  medicine     Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  price        Float
  /// Physically on the shelf. Maintained by StockMovement — never edited
  /// directly, so every change has a reason attached to it.
  stock        Int      @default(0)
  /// Promised to paid orders that have not been dispatched yet. Sellable stock
  /// is `stock - reserved`; without this, two customers can be sold the last box.
  reserved     Int      @default(0)
  /// Alert threshold for the partner app's low-stock notification.
  reorderLevel Int      @default(10)
  isActive     Boolean  @default(true)

  /// Current batch on the shelf. Kept here for the common case; the full
  /// history lives on the movements.
  batchNumber String?
  expiryDate  DateTime?

  updatedAt    DateTime @updatedAt

  movements StockMovement[]

  @@unique([pharmacyId, medicineId])
  @@index([medicineId])
  @@index([pharmacyId, isActive])
  @@index([expiryDate])
}

/// One change to one shop's stock of one medicine.
///
/// Append-only. `balanceAfter` is recorded at write time so a statement can be
/// read back without replaying the whole ledger, and so a discrepancy between
/// the ledger and `PharmacyInventory.stock` is detectable rather than invisible.
model StockMovement {
  id          String            @id @default(uuid())
  inventoryId String
  inventory   PharmacyInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  pharmacyId  String
  medicineId  String

  /// Signed: positive is stock in, negative is stock out.
  delta        Int
  reason       StockMovementReason
  /// On-hand quantity immediately after this movement.
  balanceAfter Int
  note         String?

  batchNumber String?
  expiryDate  DateTime?

  /// Set when a platform order caused this movement.
  medicineOrderId String?
  /// Who recorded it. Null for movements the system made itself.
  actorUserId     String?

  createdAt DateTime @default(now())

  @@index([pharmacyId, createdAt])
  @@index([inventoryId, createdAt])
  @@index([reason, createdAt])
  @@index([medicineOrderId])
}

model MedicineOrder {
  id          String      @id @default(uuid())
  patientId   String
  patient     Patient     @relation(fields: [patientId], references: [id])
  pharmacyId  String?
  pharmacy    Pharmacy?   @relation(fields: [pharmacyId], references: [id])
  items       Json
  totalAmount Float
  deliveryFee Float       @default(0)
  status      OrderStatus @default(PLACED)
  address     String
  latitude    Float?
  longitude   Float?

  /// Required before dispatching any prescription-only item.
  prescriptionId String?
  /// Set when the order came from an approved prescription rather than the
  /// patient adding items to a cart themselves.
  fulfilmentId   String?
  fulfilment     PrescriptionFulfilment? @relation(fields: [fulfilmentId], references: [id])

  /// Partner staff today; a dedicated rider app can consume the same field
  /// later without a migration.
  assignedAgentUserId String?
  assignedAgent       User?     @relation("OrderAgent", fields: [assignedAgentUserId], references: [id])
  acceptedAt          DateTime?
  dispatchedAt        DateTime?
  deliveredAt         DateTime?
  cancelReason        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment Payment?

  @@index([patientId])
  @@index([pharmacyId, status])
  @@index([assignedAgentUserId])
}

// ---------------------------------------------------------------------------
// Diagnostics
// ---------------------------------------------------------------------------

model LabPackage {
  id          String   @id @default(uuid())
  testName    String
  category    String
  /// National fallback, used when no LabTestPrice covers an area.
  price       Float
  sampleType  String
  fastingReq  Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())

  offerings  LabOffering[]
  prices     LabTestPrice[]
  prescribed PrescribedLabTest[]

  @@index([category])
}

/// What a test costs in an area. Set by the platform, not by the lab.
///
/// A patient cannot judge a blood test the way they can judge a restaurant, so
/// letting labs price freely against each other selects for the cheapest
/// sample handling rather than the best. One price per test per area means labs
/// compete on turnaround, accreditation and service instead.
///
/// Resolution is most-specific-first: the patient's state and city, then the
/// state alone, then the national row, then LabPackage.price. Empty string
/// means "any" — a nullable column would not enforce uniqueness in Postgres,
/// where NULLs are all distinct from one another.
model LabTestPrice {
  id                String     @id @default(uuid())
  labPackageId      String
  labPackage        LabPackage @relation(fields: [labPackageId], references: [id], onDelete: Cascade)
  /// "" means any state.
  state             String     @default("")
  /// "" means any city within `state`.
  city              String     @default("")
  price             Float
  homeCollectionFee Float      @default(0)
  isActive          Boolean    @default(true)
  note              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([labPackageId, state, city])
  @@index([labPackageId, isActive])
}

/// A test this lab can actually run.
///
/// Capability only. Labs add and remove these as their equipment changes, and
/// set their own turnaround — but the price comes from LabTestPrice, so the
/// same test costs the same across an area whichever lab fulfils it.
model LabOffering {
  id              String     @id @default(uuid())
  labPartnerId    String
  labPartner      LabPartner @relation(fields: [labPartnerId], references: [id], onDelete: Cascade)
  labPackageId    String
  labPackage      LabPackage @relation(fields: [labPackageId], references: [id], onDelete: Cascade)
  turnaroundHours Int        @default(24)
  /// Turned off when a machine is down, without losing the offering.
  isActive        Boolean    @default(true)
  updatedAt       DateTime   @updatedAt

  @@unique([labPartnerId, labPackageId])
  @@index([labPackageId])
  @@index([labPartnerId, isActive])
}

model LabOrder {
  id           String         @id @default(uuid())
  patientId    String
  patient      Patient        @relation(fields: [patientId], references: [id])
  labPartnerId String?
  labPartner   LabPartner?    @relation(fields: [labPartnerId], references: [id])
  testName     String
  price        Float
  status       LabOrderStatus @default(BOOKED)
  address      String?
  latitude     Float?
  longitude    Float?

  /// Legacy plain-URL field, retained only for rows created before reports
  /// moved into authorised Document storage. New reports use `documents`.
  reportUrl String?

  /// Set when the booking came from an approved prescription.
  fulfilmentId String?
  fulfilment   PrescriptionFulfilment? @relation(fields: [fulfilmentId], references: [id])

  scheduledAt         DateTime?
  assignedAgentUserId String?
  assignedAgent       User?     @relation("LabOrderAgent", fields: [assignedAgentUserId], references: [id])
  collectedAt         DateTime?
  completedAt         DateTime?
  cancelReason        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents Document[]
  payment   Payment?

  @@index([patientId])
  @@index([labPartnerId, status])
  @@index([assignedAgentUserId])
}

// ---------------------------------------------------------------------------
// Emergency
// ---------------------------------------------------------------------------

model EmergencySOS {
  id         String          @id @default(uuid())
  patientId  String
  patient    Patient         @relation(fields: [patientId], references: [id])
  latitude   Float
  longitude  Float
  status     EmergencyStatus @default(RAISED)
  note       String?
  resolvedAt DateTime?
  createdAt  DateTime        @default(now())

  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model DeviceToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  appId      AppId
  platform   String
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId, appId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(GENERIC)
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// ---------------------------------------------------------------------------
// Money
// ---------------------------------------------------------------------------

/// Mirrors the state held by the licensed payment aggregator. The platform
/// does not custody funds — the aggregator escrows and split-settles, so this
/// table is a local view for reconciliation and partner-facing statements.
///
/// `status` here is a *reflection* of the gateway's opinion, never the source of
/// truth. It is only ever advanced by a verified signature (client handoff) or a
/// verified webhook, so a client cannot talk its own order into being paid.
model Payment {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  purpose     PaymentPurpose
  method      PaymentMethod  @default(UPI)
  /// What the payer is charged, inclusive of delivery and collection fees.
  amount      Float
  /// The platform's cut, already contained within `amount`.
  platformFee Float          @default(0)
  currency    String         @default("INR")
  status      PaymentStatus  @default(PENDING)

  gateway           String?
  gatewayOrderId    String?
  gatewayPaymentId  String?
  /// Identifier of the settlement leg paid out to the provider.
  gatewayTransferId String?
  failureReason     String?

  paidAt         DateTime?
  refundedAmount Float     @default(0)
  refundedAt     DateTime?
  refundReason   String?
  gatewayRefundId String?

  /// Guards against a retried checkout creating a second charge for one order.
  idempotencyKey String? @unique

  appointmentId   String?        @unique
  appointment     Appointment?   @relation(fields: [appointmentId], references: [id])
  medicineOrderId String?        @unique
  medicineOrder   MedicineOrder? @relation(fields: [medicineOrderId], references: [id])
  labOrderId      String?        @unique
  labOrder        LabOrder?      @relation(fields: [labOrderId], references: [id])
  /// Set when this pays for a whole approved prescription basket, which may
  /// cover a medicine order and several lab bookings at once.
  fulfilmentId    String?                 @unique
  fulfilment      PrescriptionFulfilment? @relation(fields: [fulfilmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  splits PaymentSplit[]

  @@index([userId])
  @@index([status])
  @@index([gatewayOrderId])
  @@index([gatewayPaymentId])
}

/// One payee's share of a payment.
///
/// The platform is a marketplace: the pharmacy sells the medicine, the lab runs
/// the test. Collecting the full amount into a platform account and paying
/// partners out later makes the platform a payment aggregator, which needs an
/// RBI authorisation. Instead the licensed aggregator splits at settlement and
/// this table records the arithmetic for statements and reconciliation.
model PaymentSplit {
  id        String      @id @default(uuid())
  paymentId String
  payment   Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  payeeType PayeeType
  /// Pharmacy / LabPartner / Doctor id. Null for the platform's own leg.
  payeeId   String?
  /// The payee's account at the aggregator, resolved when the split is built.
  /// Null means the partner has not finished payout onboarding yet.
  payoutAccountId String?
  amount    Float
  status    SplitStatus @default(PENDING)
  gatewayTransferId String?
  settledAt DateTime?
  createdAt DateTime    @default(now())

  @@index([paymentId])
  @@index([payeeType, payeeId])
  @@index([status])
}

/// A webhook the gateway has delivered. Recorded before it is acted on, so a
/// redelivery (which gateways do routinely) cannot apply the same event twice.
model PaymentWebhookEvent {
  id         String   @id @default(uuid())
  gateway    String
  /// The gateway's own event id, or a hash of the payload when it sends none.
  eventId    String
  eventType  String
  payload    Json
  processedAt DateTime?
  error      String?
  createdAt  DateTime @default(now())

  @@unique([gateway, eventId])
  @@index([processedAt])
}

// ---------------------------------------------------------------------------
// Health content & emergency directory
// ---------------------------------------------------------------------------

/// Educational content matched against a patient's own record.
///
/// `audience` plus `matchValues` decide who sees a tip: a diabetes tip reaches
/// patients whose chronicConditions mention diabetes, not everyone. Health
/// content that ignores the reader's condition is spam, and people mute it.
model HealthTip {
  id          String            @id @default(uuid())
  title       String
  body        String
  category    String
  audience    HealthTipAudience @default(EVERYONE)
  /// Lowercased terms matched against the patient's conditions, allergies or
  /// recent diagnoses. Empty for EVERYONE.
  matchValues String[]
  minAge      Int?
  maxAge      Int?
  /// Higher wins when several tips match.
  priority    Int               @default(0)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  deliveries HealthTipDelivery[]

  @@index([audience, isActive])
}

/// Records that a tip reached a patient, so the same advice is not sent twice.
model HealthTipDelivery {
  id          String    @id @default(uuid())
  healthTipId String
  healthTip   HealthTip @relation(fields: [healthTipId], references: [id], onDelete: Cascade)
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([healthTipId, patientId])
  @@index([patientId, createdAt])
}

/// Ambulance, hospital and blood bank numbers, resolved by area.
///
/// Deliberately a directory rather than a dispatch integration: calling an
/// ambulance is a phone call. The useful thing an app can do in an emergency is
/// surface the right number instantly, not pretend to send a vehicle.
model EmergencyService {
  id       String               @id @default(uuid())
  name     String
  type     EmergencyServiceType
  phone    String
  altPhone String?

  address    String?
  city       String?
  state      String?
  pincode    String?
  latitude   Float?
  longitude  Float?
  /// Set for a service covering a whole state or the country (e.g. 108).
  isNational Boolean @default(false)

  is24x7   Boolean @default(true)
  notes    String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, isActive])
  @@index([city])
  @@index([isNational])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// Append-only record of privileged actions — role grants, application
/// decisions, prescription issuance, report access. Required evidence for a
/// system that carries prescriptions and health records.
model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}
